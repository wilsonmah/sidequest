# Hosted mode. Copy to your host's environment settings; never commit real values.
SIDEQUEST_MODE=hosted
SIDEQUEST_DB=/data/sidequest.sqlite3
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
BASE_URL=https://your-domain.com
FREE_ACTIVE_QUESTS=3
# Stripe: Dashboard > Developers. Use sk_test_ keys until launch.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
# Transactional email for password resets (Postmark, Resend, SES or any SMTP relay).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=SideQuest <hello@your-domain.com>
